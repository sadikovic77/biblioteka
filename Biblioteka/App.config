<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!-- Verzija runtimea: mora ostati .NET Framework 4.8 -->
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<!-- Connection string prema LocalDB bazi; Integrated Security = Windows prijava, bez lozinke -->
	<connectionStrings>
		<add name="BibliotekaDB"
             connectionString="Server=(localdb)\MSSQLLocalDB;Database=BibliotekaDB;Integrated Security=True;"
             providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>